---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
{% else %}
  {% assign collection = site.books %}
{% endif %}

{% if collection and collection.size > 0 %}

  {%- comment -%}
  Books whose status is "on shelf" get their own section at the end,
  separate from the main (reading/read) list.
  {%- endcomment -%}
  {% assign on_shelf_books = collection | where: "status", "On Shelf" %}
  {% assign main_books = collection | where_exp: "b", "b.status != 'On Shelf'" %}

  {%- comment -%}
  Sort by `finished` date descending; items without `finished` appended last.
  {%- endcomment -%}
  {% assign finished_books = main_books | where_exp: "b", "b.finished != nil and b.finished != ''" | sort: "finished" | reverse %}
  {% assign unfinished_books = main_books | where_exp: "b", "b.finished == nil or b.finished == ''" %}
  {% assign sorted_books = finished_books | concat: unfinished_books %}

  <div class="bookshelf">
    {% for book in sorted_books %}
      {% include book-item.liquid book=book %}
    {% endfor %}
  </div>

  {% if on_shelf_books.size > 0 %}
    {% assign shelf_finished = on_shelf_books | where_exp: "b", "b.finished != nil and b.finished != ''" | sort: "finished" | reverse %}
    {% assign shelf_unfinished = on_shelf_books | where_exp: "b", "b.finished == nil or b.finished == ''" %}
    {% assign sorted_shelf_books = shelf_finished | concat: shelf_unfinished %}

    <h3 class="bookshelf-section-heading">On the Shelf</h3>

    <div class="bookshelf">
      {% for book in sorted_shelf_books %}
        {% include book-item.liquid book=book %}
      {% endfor %}
    </div>
  {% endif %}

{% else %}
  <p>No books found.</p>
{% endif %}
